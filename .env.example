DATABASE_URL=postgresql+psycopg://postgres:postgrespassword@localhost:45432/rag_db

EMBEDDING_PROVIDER=mock
LLM_PROVIDER=mock

OPENAI_API_KEY=
GEMINI_API_KEY=
COHERE_API_KEY=

OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_LLM_MODEL=gpt-4o-mini
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_LLM_MODEL=gemini-2.5-flash
COHERE_EMBEDDING_MODEL=embed-v4.0
COHERE_LLM_MODEL=command-a-03-2025

DEFAULT_CHUNK_SIZE=500
DEFAULT_CHUNK_OVERLAP=50
DEFAULT_TOP_K=5
RAG_NEIGHBOR_WINDOW=1
EMBEDDING_DIMENSION=1536
EMBEDDING_MAX_RETRIES=1
EMBEDDING_RETRY_BASE_SECONDS=1
EMBEDDING_RETRY_MAX_SECONDS=30
COHERE_EMBEDDING_BATCH_SIZE=96
MAX_UPLOAD_SIZE_MB=20
DB_INSERT_BATCH_SIZE=100

CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
