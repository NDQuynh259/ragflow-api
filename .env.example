# ==============================================================================
# Application Configuration
# ==============================================================================
APP_NAME="RAG Chat API"
APP_VERSION="0.1.0"
API_V1_PREFIX="/api/v1"
DEBUG=false

# ==============================================================================
# Database Configuration
# ==============================================================================
DATABASE_URL=postgresql+psycopg://postgres:postgrespassword@localhost:45432/rag_db

# ==============================================================================
# Storage Configuration
# ==============================================================================
STORAGE_DIR="output/storage"
STORAGE_BACKEND="minio_with_local_fallback"
STORAGE_SYNC_INTERVAL_SECONDS=60
STORAGE_SYNC_MAX_RETRIES=10
MAX_UPLOAD_SIZE_MB=20

# MinIO / S3 Object Storage Configuration
MINIO_ENDPOINT="localhost:9000"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET_NAME="rag-documents"
MINIO_SECURE=false
MINIO_REGION="us-east-1"


# ==============================================================================
# RabbitMQ Message Broker Configuration
# ==============================================================================
RABBITMQ_URL="amqp://guest:guest@localhost:5672/"
RABBITMQ_INGESTION_QUEUE="rag.document.ingestion"
RABBITMQ_EXCHANGE="rag.direct"
RABBITMQ_ROUTING_KEY="document.ingestion"

# ==============================================================================
# AI API Providers (cohere / gemini / openai / mock)
# ==============================================================================
EMBEDDING_PROVIDER=gemini
LLM_PROVIDER=gemini

# Gemini Configuration
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_LLM_MODEL=gemini-2.5-flash

# OpenAI Configuration
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_LLM_MODEL=gpt-4o-mini

# Cohere Configuration
COHERE_API_KEY=
COHERE_EMBEDDING_MODEL=embed-v4.0
COHERE_LLM_MODEL=command-a-03-2025

# ==============================================================================
# RAG Chunking & Retrieval Configuration
# ==============================================================================
DEFAULT_CHUNK_SIZE=1200
DEFAULT_CHUNK_OVERLAP=200
DEFAULT_TOP_K=5
DEFAULT_RERANK=true
RAG_NEIGHBOR_WINDOW=1

# ==============================================================================
# Security & CORS Configuration
# ==============================================================================
SECRET_KEY="insecure-secret-key-for-development"
CORS_ORIGINS=["*"]
SESSION_COOKIE_SECURE=false
