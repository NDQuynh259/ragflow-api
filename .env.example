# Example environment configuration.
# Copy to .env and fill in your API keys.

# Database
DATABASE_URL=postgresql+psycopg://postgres:postgrespassword@localhost:45432/rag_db

# Provider selection
EMBEDDING_PROVIDER=gemini
LLM_PROVIDER=gemini

# API Keys (required)
GEMINI_API_KEY=your-gemini-api-key-here

# Optional alternative providers
OPENAI_API_KEY=
COHERE_API_KEY=

# Model configuration
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_LLM_MODEL=gemini-2.5-flash
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_LLM_MODEL=gpt-4o-mini
COHERE_EMBEDDING_MODEL=embed-v4.0
COHERE_LLM_MODEL=command-a-03-2025

# Pipeline configuration
DEFAULT_CHUNK_SIZE=1200
DEFAULT_CHUNK_OVERLAP=200
DEFAULT_TOP_K=5
RAG_NEIGHBOR_WINDOW=1

# Embedding configuration
EMBEDDING_DIMENSION=768
EMBEDDING_MAX_RETRIES=3
EMBEDDING_RETRY_BASE_SECONDS=1
EMBEDDING_RETRY_MAX_SECONDS=30
COHERE_EMBEDDING_BATCH_SIZE=96

# Upload limits
MAX_UPLOAD_SIZE_MB=20
DB_INSERT_BATCH_SIZE=100

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
